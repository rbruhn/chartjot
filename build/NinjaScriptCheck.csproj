<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-check only: verifies NinjaScript sources compile against NT8's
       assemblies. The real build happens in NinjaTrader (NinjaScript Editor -> F5). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>5</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NT8Bin>/mnt/c/Program Files/NinjaTrader 8/bin</NT8Bin>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Mirror NT8's real NinjaScript references: only add a reference that
       bin/Custom/NinjaTrader.Custom.csproj lists AND whose DLL actually exists
       (its Newtonsoft.Json entry points at a missing file). -->
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="NinjaTrader.Core"><HintPath>$(NT8Bin)/NinjaTrader.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NinjaTrader.Gui"><HintPath>$(NT8Bin)/NinjaTrader.Gui.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../spike/*.cs" />
  </ItemGroup>
</Project>
